services:
  broker:
    container_name: paperless-redis
    image: docker.io/library/redis:8
    volumes:
      - /srv/paperless/redis:/data
    restart: unless-stopped
    networks:
      - paperless-backend

  db:
    container_name: paperless-db
    image: docker.io/library/postgres:18
    volumes:
      - /srv/paperless/db:/var/lib/postgresql
    environment:
      POSTGRES_DB: paperless
      POSTGRES_USER: paperless
      POSTGRES_PASSWORD: "{{ lookup('env', 'PAPERLESS_DB_PASSWORD') }}"
    restart: unless-stopped
    networks:
      - paperless-backend

  paperless:
    container_name: paperless
    image: ghcr.io/paperless-ngx/paperless-ngx:latest
    depends_on:
      - db
      - broker
    volumes:
      - /srv/paperless/data/data:/usr/src/paperless/data
      - /srv/paperless/data/media:/usr/src/paperless/media
      - /srv/paperless/data/export:/usr/src/paperless/export
      - /srv/paperless/data/consume:/usr/src/paperless/consume
    environment:
      USERMAP_UID: 1000
      USERMAP_GID: 1000
      PAPERLESS_TIME_ZONE: "{{ timezone }}"
      PAPERLESS_OCR_LANGUAGE: "{{ language }}"
      PAPERLESS_REDIS: redis://broker:6379
      PAPERLESS_DBHOST: db
      PAPERLESS_DBNAME: paperless
      PAPERLESS_DBUSER: paperless
      PAPERLESS_DBPASS: "{{ lookup('env', 'PAPERLESS_DB_PASSWORD') }}"
    restart: unless-stopped
    networks:
      - gateway
      - paperless-backend

networks:
  gateway:
    external: true
  paperless-backend:
    driver: bridge